{
  "name": "core",
  "version": "1.41.0",
  "description": "The core module of my.aegee.eu",
  "keywords": [],
  "author": "Sergey Peshkov",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.6.2",
    "nock": "^15.0.6",
    "rimraf": "^6.1.4",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "nodemon-start": "nodemon -L -e 'js,json' lib/run.js",
    "test": "NODE_ENV=test npm run db:setup && NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest test/**/*.test.js --runInBand --forceExit",
    "test:ci": "NODE_ENV=test npm run db:setup && NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --runInBand --forceExit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint-staged": "lint-staged",
    "db:create": "sequelize db:create",
    "db:setup": "sequelize db:drop; sequelize db:create; sequelize db:migrate; rm -f state/.seed-executed-$NODE_ENV",
    "db:migrate": "sequelize db:migrate",
    "db:seed": "LOGLEVEL=info node --experimental-repl-await scripts/seed.js && touch state/.seed-executed-$NODE_ENV",
    "db:clear": "LOGLEVEL=info node  --experimental-repl-await scripts/clear.js; rm -f state/.seed-executed-$NODE_ENV",
    "db:recreate": "npm run db:setup && npm run db:seed",
    "semantic-release": "semantic-release"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/../packages/backend-test-utils/jest-global-setup.js",
    "verbose": true,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "lib/**/*.js",
      "models/**/*.js",
      "middlewares/**/*.js",
      "!lib/sequelize.js",
      "!lib/logger.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    },
    "reporters": [
      "default",
      "jest-junit"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/scripts/mail-contract.js",
      "<rootDir>/test/scripts/nock-cleanup.js"
    ]
  },
  "dependencies": {
    "@bugsnag/js": "^9.1.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.4.0",
    "bunyan": "^1.8.15",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "file-type": "^22.3.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "on-finished": "^2.4.2",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "qs": "^6.17.1",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.3"
  }
}
