{
  "name": "core",
  "version": "1.41.0",
  "description": "The core module of my.aegee.eu",
  "keywords": [],
  "author": "Sergey Peshkov",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "eslint": "^10.0.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.1.1",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.1.5",
    "nock": "^14.0.10",
    "rimraf": "^6.0.1"
  },
  "scripts": {
    "test": "NODE_ENV=test npm run db:setup && jest test/**/*.test.js --runInBand --forceExit",
    "test:ci": "NODE_ENV=test npm run db:setup && jest --runInBand --forceExit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint-staged": "lint-staged",
    "db:create": "sequelize db:create",
    "db:setup": "sequelize db:drop; sequelize db:create; sequelize db:migrate; rm -f state/.seed-executed-$NODE_ENV",
    "db:migrate": "sequelize db:migrate",
    "db:seed": "LOGLEVEL=info node --experimental-repl-await scripts/seed.js && touch state/.seed-executed-$NODE_ENV",
    "db:clear": "LOGLEVEL=info node  --experimental-repl-await scripts/clear.js; rm -f state/.seed-executed-$NODE_ENV",
    "db:recreate": "npm run db:setup && npm run db:seed",
    "semantic-release": "semantic-release"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "lib/**/*.js",
      "models/**/*.js",
      "middlewares/**/*.js",
      "!lib/run.js",
      "!lib/sequelize.js",
      "!lib/logger.js",
      "!lib/fs.js",
      "!lib/merge.js",
      "!lib/errors.js"
    ],
    "reporters": [
      "default",
      "jest-junit"
    ]
  },
  "dependencies": {
    "@bugsnag/js": "^8.4.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^2.2.0",
    "bunyan": "^1.8.15",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-promise-router": "^4.1.1",
    "express-query-boolean": "^2.0.0",
    "file-type": "^16.5.4",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "on-finished": "^2.4.1",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "read-chunk": "^3.2.0",
    "request": "^2.88.2",
    "request-promise-native": "^1.0.9",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3"
  }
}
