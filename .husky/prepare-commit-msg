# Add helpful comment to commit message template
if [ -z "$2" ]; then
  echo "# Commit format: <type>(<scope>): <subject>" >> $1
  echo "#" >> $1
  echo "# Valid scopes (commitlint.config.js):" >> $1
  echo "#   modules: core, events, frontend, discounts, network, statutory," >> $1
  echo "#            summeruniversity, mailer, dispatcher, e2e" >> $1
  echo "#   other:   ci, docker, deps, deps-dev, monorepo, infra, docs, readme" >> $1
  echo "#" >> $1
  echo "# Examples:" >> $1
  echo "#   feat(core): add new user authentication" >> $1
  echo "#   fix(frontend): resolve rendering bug on dashboard" >> $1
  echo "#   chore(ci): update CircleCI configuration" >> $1
fi
