{$CADDY_SITE_SCHEME}{$SUBDOMAIN_METRICS}{$BASE_URL} {
	handle /ext-metrics/cadvisor* {
		basic_auth {
			admin {env.PW_TRAEFIK}
		}
		uri strip_prefix /ext-metrics/cadvisor
		reverse_proxy cadvisor:8080
	}
	handle /ext-metrics/node-exporter* {
		basic_auth {
			admin {env.PW_TRAEFIK}
		}
		uri strip_prefix /ext-metrics/node-exporter
		reverse_proxy node-exporter-tunnel:5001
	}
}
