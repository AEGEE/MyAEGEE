{
  "name": "statutory",
  "version": "1.14.8",
  "description": "Statutory events module for MyAEGEE",
  "main": "lib/server.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "db:create": "sequelize db:create",
    "db:setup": "sequelize db:drop; sequelize db:create; sequelize db:migrate",
    "db:migrate": "sequelize db:migrate",
    "test": "NODE_ENV=test npm run db:setup && jest test/api/*.test.js --runInBand --forceExit",
    "test:ci": "NODE_ENV=test npm run db:setup && jest --runInBand --forceExit",
    "semantic-release": "semantic-release"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "lib/**/*.js",
      "models/**/*.js",
      "!lib/run.js",
      "!lib/sequelize.js",
      "!lib/logger.js"
    ],
    "reporters": [
      "default",
      "jest-junit"
    ]
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint"
  },
  "keywords": [],
  "author": "Sergey Peshkov <github.com/serge1peshcoff>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AEGEE/statutory/issues"
  },
  "homepage": "https://github.com/AEGEE/statutory",
  "dependencies": {
    "@bugsnag/js": "^8.4.0",
    "body-parser": "^2.2.0",
    "bunyan": "^1.8.15",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-promise-router": "^4.1.1",
    "express-query-boolean": "^2.0.0",
    "file-type": "^16.5.4",
    "joi": "^18.0.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-range": "^4.0.2",
    "moment-timezone": "^0.6.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-schedule": "^2.1.1",
    "node-xlsx": "^0.24.0",
    "on-finished": "^2.4.1",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "qs": "^6.15.0",
    "read-chunk": "^3.2.0",
    "request": "^2.88.2",
    "request-promise-native": "^1.0.9",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.2.4",
    "nock": "^14.0.10",
    "rimraf": "^6.0.1",
    "timekeeper": "^2.3.1"
  }
}
