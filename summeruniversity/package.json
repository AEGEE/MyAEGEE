{
  "name": "summeruniversity",
  "version": "1.6.6",
  "description": "Summer University module of MyAEGEE",
  "main": "lib/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "nodemon-start": "nodemon -L -e 'js,json' lib/run.js",
    "test": "npm run test:ci --",
    "test:ci": "NODE_ENV=test npm run db:setup && NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "db:create": "sequelize db:create",
    "db:setup": "sequelize db:drop; sequelize db:create; sequelize db:migrate",
    "db:migrate": "sequelize db:migrate",
    "semantic-release": "semantic-release"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "collectCoverage": true,
    "globalSetup": "<rootDir>/../packages/backend-test-utils/jest-global-setup.js",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "collectCoverageFrom": [
      "lib/**/*.js",
      "models/**/*.js"
    ],
    "reporters": [
      "default",
      "jest-junit"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/scripts/mail-contract.js",
      "<rootDir>/test/scripts/nock-cleanup.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "author": "Rik Smale <github.com/WikiRik>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AEGEE/summeruniversity/issues"
  },
  "homepage": "https://github.com/AEGEE/summeruniversity#readme",
  "dependencies": {
    "@bugsnag/js": "^9.1.0",
    "body-parser": "^2.2.0",
    "bunyan": "^1.8.15",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "file-type": "^22.3.0",
    "joi": "^18.3.2",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-schedule": "^2.1.2",
    "node-xlsx": "^0.25.0",
    "on-finished": "^2.4.2",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "qs": "^6.17.1",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.6.1",
    "nock": "^15.0.6",
    "rimraf": "^6.1.4",
    "timekeeper": "^2.3.1",
    "yaml": "^2.9.1"
  }
}
