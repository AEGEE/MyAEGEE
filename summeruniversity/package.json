{
  "name": "summeruniversity",
  "version": "1.6.6",
  "description": "Summer University module of MyAEGEE",
  "main": "lib/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "nodemon-start": "nodemon -L -e 'js,json' lib/run.js",
    "test": "NODE_ENV=test npm run db:setup && jest test/api/*.js --runInBand --forceExit",
    "test:ci": "NODE_ENV=test npm run db:setup && jest --runInBand --forceExit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "db:create": "sequelize db:create",
    "db:setup": "sequelize db:drop; sequelize db:create; sequelize db:migrate",
    "db:migrate": "sequelize db:migrate",
    "semantic-release": "semantic-release"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "lib/**/*.js",
      "models/**/*.js",
      "!lib/run.js",
      "!lib/sequelize.js",
      "!lib/logger.js"
    ],
    "reporters": [
      "default",
      "jest-junit"
    ]
  },
  "author": "Rik Smale <github.com/WikiRik>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AEGEE/summeruniversity/issues"
  },
  "homepage": "https://github.com/AEGEE/summeruniversity#readme",
  "dependencies": {
    "@bugsnag/js": "^8.9.0",
    "@faker-js/faker": "^10.4.0",
    "body-parser": "^2.2.0",
    "bunyan": "^1.8.15",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-promise-router": "^4.1.1",
    "express-query-boolean": "^2.0.0",
    "file-type": "^16.5.4",
    "joi": "^17.13.3",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-schedule": "^2.1.1",
    "node-xlsx": "^0.24.0",
    "on-finished": "^2.4.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "read-chunk": "^3.2.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.3"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.3.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.4.0",
    "nock": "^14.0.14",
    "rimraf": "^6.1.3",
    "timekeeper": "^2.3.1"
  }
}
