{
  "name": "myaegee-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MyAEGEE Platform - Monorepo for all microservices",
  "repository": {
    "type": "git",
    "url": "https://github.com/AEGEE/MyAEGEE.git"
  },
  "author": "AEGEE Europe",
  "license": "ISC",
  "workspaces": [
    "core",
    "events",
    "frontend",
    "discounts",
    "network",
    "statutory",
    "summeruniversity",
    "mailer",
    "e2e"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@redocly/cli": "2.83.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "openapi-typescript": "7.13.0",
    "semantic-release": "^26.0.1",
    "semantic-release-monorepo": "^8.0.2"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "~6.0.3"
    }
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "husky || true",
    "postinstall": "echo '✓ Workspace setup complete - all 9 modules ready'",
    "test": "echo 'Run tests in individual modules'",
    "lint": "echo 'Run linters in individual modules'",
    "openapi:lint": "redocly lint && node packages/backend-test-utils/spec-lint.js",
    "openapi:types": "openapi-typescript",
    "openapi:types:check": "openapi-typescript && git diff --exit-code -- 'packages/api-types/*.ts' packages/backend-test-utils/test/fixtures/openapi.ts && test -z \"$(git status --porcelain -- 'packages/api-types/*.ts' packages/backend-test-utils/test/fixtures/openapi.ts)\"",
    "openapi:check": "redocly lint && node packages/backend-test-utils/spec-lint.js && npm run openapi:types:check && node --test packages/backend-test-utils/test/"
  }
}
