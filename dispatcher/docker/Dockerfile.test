FROM python:3.15-slim@sha256:63bb298d2b7b88f176f51b5189f54ce6535c997682ea70885d2132f5d473a8a5

WORKDIR /usr/app

RUN pip install --no-cache-dir pika==1.3.2 Faker==37.0.0

COPY ./helpers /usr/app/helpers
COPY ./templates /usr/app/templates

WORKDIR /usr/app/helpers

ENV RABBIT_HOST=rabbit

ENTRYPOINT ["python", "-u", "send.py"]
