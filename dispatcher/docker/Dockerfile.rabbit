# NOTE: rabbitmq-delayed-message-exchange was archived on 2026-04-16 and will NOT be ported
# to RabbitMQ 4.x (Mnesia removal in 4.3+). The long-term fix is to replace the wait_exchange
# pattern with native DLX + per-queue TTL. Track this in the retry-refactor task.
FROM rabbitmq:3.13-management

ADD https://github.com/rabbitmq/rabbitmq-delayed-message-exchange/releases/download/3.13.0/rabbitmq_delayed_message_exchange-3.13.0.ez /opt/rabbitmq/plugins
RUN chown rabbitmq:rabbitmq /opt/rabbitmq/plugins/rabbitmq_delayed_message_exchange-3.13.0.ez \
  && chmod 755 /opt/rabbitmq/plugins/rabbitmq_delayed_message_exchange-3.13.0.ez \
  && rabbitmq-plugins enable rabbitmq_delayed_message_exchange --offline
