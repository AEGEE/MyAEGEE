{
  "name": "myaegee-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end tests for MyAEGEE across core, events, summeruniversity, statutory and the frontend",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "lint": "eslint --ext .ts . && tsc --noEmit && node scripts/check-ignores.ts && node scripts/check-factory-contracts.ts",
    "setup": "node scripts/prepare.ts",
    "setup:no-frontend": "node scripts/prepare.ts --skip-frontend",
    "setup:frontend": "node scripts/prepare.ts --frontend-only",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "coverage": "node scripts/coverage.ts merge && node scripts/coverage.ts report",
    "coverage:gate": "node scripts/coverage.ts gate"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-lib-source-maps": "^5.0.6",
    "istanbul-reports": "^3.2.0",
    "typescript": "~6.0.3"
  }
}
