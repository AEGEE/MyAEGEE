{
  "name": "myaegee-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end tests for MyAEGEE across core, events, summeruniversity and the frontend",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "eslint --ext .ts . && tsc --noEmit",
    "setup": "node scripts/prepare.ts",
    "setup:no-frontend": "node scripts/prepare.ts --skip-frontend",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "~6.0.3"
  }
}
